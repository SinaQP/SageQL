# Copy this file to .env and fill in values you want to reuse.
# Leave a field blank to enter it interactively when the chat starts.
# Authentication is the method name only; do not put a database password here.
DB_SERVER_HOST=
DB_NAME=
DB_AUTHENTICATION=
DB_ODBC_DRIVER=

# Keep your real API key only in the ignored .env file or an environment variable.
LLM_API_KEY=
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_MODEL=gpt-5-nano
